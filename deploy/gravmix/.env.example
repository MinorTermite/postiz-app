# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# === Image and ports
# postiz-ru:latest is built from this fork (installer loads it from postiz-ru-image.tar.gz)
POSTIZ_IMAGE=postiz-ru:latest
POSTIZ_BIND=127.0.0.1
POSTIZ_PORT=4007
TEMPORAL_UI_PORT=8088

# === Public address. Local: http://localhost:4007. With a domain: https://postiz.example.ru
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# === Secrets (generated by setup.ps1)
JWT_SECRET=
POSTGRES_PASSWORD=

# Set to true after the owner account is created.
DISABLE_REGISTRATION=true
# Meta (facebook, instagram, threads) and X are not available in Russia - hidden from "Add channel"
HIDDEN_PROVIDERS=facebook,instagram,instagram-standalone,threads,x
# Required while working over plain http://localhost (cookies without Secure flag).
NOT_SECURED=true
API_LIMIT=30

# === Channels for GravMix / Slava
# Telegram: bot from @BotFather, the bot must be an admin of the channel.
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=
# VK (personal wall and communities): app at https://id.vk.com/about/business/go
# redirects: <FRONTEND_URL>/integrations/social/vk and <FRONTEND_URL>/integrations/social/vk-group
# (over http://localhost they go through https://redirectmeto.com/ automatically)
VK_ID=
# MAX, Odnoklassniki, Rutube: keys are entered in the UI when the channel is added, nothing here.
# YouTube and "Sign in with Google": one Google Cloud OAuth client (Web application),
# redirect <FRONTEND_URL>/integrations/social/youtube. The Google button appears once both are set.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Instagram (business via Facebook) and Threads
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# X / LinkedIn (optional)
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# === AI assistant inside Postiz (optional)
OPENAI_API_KEY=
