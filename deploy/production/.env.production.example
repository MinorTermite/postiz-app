# GravMix production settings. install.sh copies this to .env and fills the secrets.
# .env is never committed. After any change:  docker compose up -d

# ============================================================== Address
# Domain pointed (DNS A record) to this server. Addresses are built from it:
#   site     https://DOMAIN
#   API      https://DOMAIN/api
DOMAIN=
# Let's Encrypt notifications about the certificate
ACME_EMAIL=
# Image: postiz-ru:latest is loaded from postiz-ru-image.tar.gz or built from the fork
POSTIZ_IMAGE=postiz-ru:latest

# ============================================================== Secrets (install.sh generates)
JWT_SECRET=
POSTGRES_PASSWORD=

# ============================================================== Access
# Commercial service: anyone can sign up. Set true to keep a private single-owner install.
DISABLE_REGISTRATION=false
# Never set NOT_SECURED on https: cookies must stay Secure
# Public API requests per hour per organization
API_LIMIT=30
# Hide providers from the add-channel screen (comma list of identifiers).
# Meta (Facebook, Instagram, Threads) is recognized extremist in RF, X is blocked.
HIDDEN_PROVIDERS=facebook,instagram,instagram-standalone,threads,x
# Disallow "+" aliases at sign-up (one trial per mailbox)
DISALLOW_PLUS=true

# ============================================================== Email (activation, password reset, notifications)
# Without EMAIL_PROVIDER accounts are activated immediately and no mail is sent.
# nodemailer = any SMTP: Yandex 360 (smtp.yandex.ru:465), Mail.ru (smtp.mail.ru:465), Unisender Go, etc.
# set to nodemailer once EMAIL_USER/EMAIL_PASS are filled, otherwise activation mails fail
EMAIL_PROVIDER=
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=GravMix
# alternative: EMAIL_PROVIDER=resend + RESEND_API_KEY

# ============================================================== Payments: YooKassa (subscriptions in rubles)
# Shop at https://yookassa.ru -> Integration -> API keys. Webhook URL in the shop settings:
#   https://DOMAIN/api/payment/yookassa   events: payment.succeeded, payment.canceled
# Billing (plans, limits, the paywall) turns on once both keys are set.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Name in the payment description and receipt
YOOKASSA_SERVICE_NAME=GravMix
# true: save the card and charge every period automatically (YooKassa must enable autopayments for the shop)
YOOKASSA_AUTOPAY=false
# true: send 54-FZ receipts through YooKassa (Cheki ot YuKassy or an online cash register)
YOOKASSA_RECEIPT=false
# VAT code for the receipt: 1 = without VAT (USN), see YooKassa docs for others
YOOKASSA_VAT_CODE=1
# Stripe is not used in RF. Leave empty.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=

# ============================================================== Storage
# local = files in the postiz-uploads volume (served by the app).
# cloudflare = any S3-compatible storage (R2, Yandex Object Storage, Selectel S3)
STORAGE_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# ============================================================== Channels
# Redirect URI of every OAuth app: https://DOMAIN/integrations/social/<identifier>
# Full list with registration steps: deploy/production/CHANNELS.md

# --- Russia
# VK: https://id.vk.com/about/business/go  (redirects .../vk and .../vk-group)
VK_ID=
# Telegram: bot from @BotFather, the bot is an admin of the channel / group
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=
# MAX, Odnoklassniki (ok), Rutube: keys are entered by each user in the add-channel form

# --- Google: YouTube + "Sign in with Google" + Google Business Profile
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GOOGLE_GMB_CLIENT_ID=
GOOGLE_GMB_CLIENT_SECRET=

# --- Video and images
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# TikTok for Business (Content Posting for business accounts)
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# --- Professional and communities
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=

# --- Streaming
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_SECRET=

# --- Fediverse and others
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
NEYNAR_CLIENT_ID=
NEYNAR_SECRET_KEY=
NEYNAR_APP_FID=
NEYNAR_APP_MNEMONIC=
WHOP_CLIENT_ID=
MEWE_APP_ID=
MEWE_API_KEY=
MEWE_HOST=
# Keyless (each user enters own credentials in the form): Bluesky, Telegram-style bots,
# WordPress, Medium, Dev.to, Hashnode, Lemmy, Nostr, Farcaster, Listmonk, Moltbook

# --- Hidden by HIDDEN_PROVIDERS (kept for completeness, do not enable in RF)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
X_API_KEY=
X_API_SECRET=

# ============================================================== Optional services
# AI assistant, image generation (OpenAI-compatible key)
OPENAI_API_KEY=
# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
# Short links in posts
DUB_TOKEN=
KUTT_API_KEY=
KUTT_API_ENDPOINT=
# Server time zone for logs
TZ=Europe/Moscow
